# ==============================================================================
# ProofPass Environment Configuration Template (.env.example)
# Digital Document Wallet & Cryptographic Blockchain Verification Platform
# ==============================================================================

# Server Environment & Port (Default: 3000 for AI Studio environment)
PORT=3000
NODE_ENV=development

# Host & Base Application URLs
# In production, AI Studio automatically sets APP_URL to the Cloud Run service URL
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"

# Optional Gemini API Key for Server-Side AI Verification & Smart Auditing
# (Users configure this via the Secrets panel in the AI Studio UI)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Default Visual Theme & Color Palette
# Theme Modes: 'oled' (Pitch Black), 'dark' (Midnight Slate), 'light' (Daylight)
# Color Palettes: 'cyan', 'emerald', 'indigo', 'amber', 'rose'
VITE_DEFAULT_THEME=oled
VITE_DEFAULT_PALETTE=cyan

# Blockchain Provider Substrate Configuration
# Options: 'local' (In-Memory Simulated Substrate), 'polygon' (Polygon Amoy), 'sepolia' (Ethereum Sepolia)
VITE_BLOCKCHAIN_PROVIDER=local

# Public EVM Testnet RPC Endpoints (Optional for testnet mode)
VITE_POLYGON_RPC=https://rpc-amoy.polygon.technology
VITE_SEPOLIA_RPC=https://rpc.sepolia.org
